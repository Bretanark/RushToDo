<wpf:ResourceDictionary xml:space="preserve" xmlns:s="clr-namespace:System;assembly=mscorlib" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wpf="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <s:String x:Key="/Default/CodeInspection/Browsers/Browsers/@EntryValue">C120+,E120+,FF120+,O100+,S17+</s:String>
    <s:String x:Key="/Default/CodeInspection/Highlighting/InspectionSeverities/=CssNotResolved/@EntryIndexedValue">SUGGESTION</s:String>
    <s:String x:Key="/Default/Environment/SqlDaemon/SolutionSqlDialect/@EntryValue">TSQL</s:String>
    <s:Boolean x:Key="/Default/UserDictionary/Words/=Dacpac/@EntryIndexedValue">True</s:Boolean>
    <s:Boolean x:Key="/Default/UserDictionary/Words/=Gardener/@EntryIndexedValue">True</s:Boolean>
    <s:Boolean x:Key="/Default/UserDictionary/Words/=Todo/@EntryIndexedValue">True</s:Boolean>
</wpf:ResourceDictionary>
